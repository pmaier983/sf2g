{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sf2g",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/ssr.tsx",
  "vars": {
    "NODE_ENV": "production",
  },
  // Sync queue drain (app/ssr.tsx → scheduled → app/server/scheduled.ts):
  // queues riders due for a sync and processes a budgeted batch of jobs.
  // Webhooks enqueue jobs; this is what turns them into rides.
  "triggers": {
    "crons": [
      "*/5 * * * *",
      // Report emails (app/server/report.ts), 16:00 UTC = 9 am PDT / 8 am PST:
      // Mondays for the previous Monday–Sunday week, the 1st for the previous
      // month. app/ssr.tsx maps each expression to its report.
      "0 16 * * 1",
      "0 16 1 * *",
    ],
  },
}
