# Copy to .env.local for local development.
#
# ⚠️  NEVER point local dev at the production Supabase project.
#     `pnpm db:start` runs a local Supabase; the values below are its
#     well-known local defaults (printed by `supabase status`).

# Strava OAuth (https://www.strava.com/settings/api — add `localhost` to the
# app's Authorization Callback Domain to log in locally)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Supabase — local defaults from `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# App
APP_URL=http://localhost:5173
SESSION_SECRET=a-random-32-character-string-for-cookie-signing

# Strava webhooks
STRAVA_WEBHOOK_VERIFY_TOKEN=a-random-string-for-webhook-verification

# Admin endpoints (/api/cron) — Bearer token
CRON_SECRET=local-cron-secret

NODE_ENV=development

# PostHog analytics (optional — disabled when unset; leave unset locally)
# VITE_POSTHOG_KEY=
