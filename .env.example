# Copy to .env.local for local development.
#
# ⚠️  NEVER point local dev at the production Supabase project.
#     `pnpm db:start` runs a local Supabase; the values below are its
#     well-known local defaults (printed by `supabase status`).

# Strava OAuth (https://www.strava.com/settings/api — add `localhost` to the
# app's Authorization Callback Domain to log in locally)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Supabase — local defaults from `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# App
APP_URL=http://localhost:5173
# Signs session cookies (HMAC-SHA256). Must be at least 32 characters.
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Strava webhooks
STRAVA_WEBHOOK_VERIFY_TOKEN=a-random-string-for-webhook-verification
# Optional: the id Strava returned when the push subscription was created
# (docs/ops/sync.md). Events for any other subscription are ignored.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Admin endpoints (/api/cron) — Bearer token
CRON_SECRET=local-cron-secret

# Comma-separated user ids allowed to call admin server functions in production
# (DevTools actions). On a local dev server every request is allowed.
ADMIN_USER_IDS=

NODE_ENV=development

# PostHog analytics (optional — disabled when unset; leave unset locally)
# VITE_POSTHOG_KEY=

# --- Observability (phase 08; all optional locally) --------------------------
# PostHog project key (public). On Cloudflare it is a Worker secret and reaches
# the browser through the root loader, not the Vite build.
# VITE_POSTHOG_KEY=phc_...
# Monthly report email (Resend). Unset = the report is stored, not sent.
# RESEND_API_KEY=re_...
# REPORT_EMAIL_TO=you@example.com
# REPORT_EMAIL_FROM="SF2G Reports <onboarding@resend.dev>"
# Site usage section (PostHog personal API key with query:read)
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=113623
# Platform section (Cloudflare API token with Account Analytics: Read)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
